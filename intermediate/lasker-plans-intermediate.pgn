[Event "Lasker plans: Free the queen bishop"]
[Site "https://lichess.org/analysis/rnbqkbnr/pppp1ppp/8/8/3pP3/2P5/PP3PPP/RNBQKBNR_b_KQkq_-_0_3"]
[White "Opponent"]
[Black "Student"]
