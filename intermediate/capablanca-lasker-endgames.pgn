[Role "teaching"]
[Variant "Standard"]
[Source "J. R. Capablanca, Chess Fundamentals (1921); Game 2, Rubinstein-Capablanca, San Sebastian 1911, line 4012; from move 30"]
[IntendedResult "win"]
[FEN "8/pp1k2pp/2n5/5R2/2B5/3P2P1/Pr3PKP/8 b - - 8 30"]
